PORT=5000

# "development" on your laptop, "production" when deployed (turns on the stricter safety checks).
NODE_ENV=development

# Leave empty to use the built-in local store (persists in server/.data).
# For a hosted deployment set a full MongoDB connection string.
MONGODB_URI=

# REQUIRED in production: a random value of at least 32 characters. The server refuses to start without it.
# Create one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Allowed frontend origin(s) for CORS in production (comma separated). Development allows any origin.
CLIENT_URL=http://localhost:3000
# Number of proxy hops in front of the server (Render = 1). Used for rate limiting.
# TRUST_PROXY=1

# Initial administrator, created only when no admin exists. REQUIRED in production.
ADMIN_EMAIL=admin@foodflow.app
ADMIN_PASSWORD=Admin@12345

# Development helper (ignored in production): creates owner@foodflow.demo / Owner@12345 with the first canteen.
# SEED_DEMO_OWNER=true

# Optional: absolute path for uploaded images. Defaults to server/uploads.
# UPLOAD_DIR=

# Optional: pin the embedded MongoDB binary version (e.g. 8.2.6).
# MONGOMS_VERSION=

# Razorpay online payments. Leave blank to disable online checkout; the API
# returns a clear 503 and the UI offers wallet / pay-at-counter instead.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard (recommended in production).
# RAZORPAY_WEBHOOK_SECRET=

