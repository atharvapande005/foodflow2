PORT=5000

# Leave empty to use the built-in local store (persists in server/.data).
# For a hosted deployment set a full MongoDB connection string.
MONGODB_URI=

# Use a long random value in production.
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Allowed frontend origin for CORS and Socket.IO.
CLIENT_URL=http://localhost:3000

# Initial administrator, created only when no admin exists.
ADMIN_EMAIL=admin@foodflow.app
ADMIN_PASSWORD=Admin@12345

# Optional: absolute path for uploaded images. Defaults to server/uploads.
# UPLOAD_DIR=

# Optional: pin the embedded MongoDB binary version (e.g. 8.2.6).
# MONGOMS_VERSION=

# Razorpay online payments. Leave blank to disable online checkout; the API
# returns a clear 503 and the UI offers wallet / pay-at-counter instead.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard (recommended in production).
# RAZORPAY_WEBHOOK_SECRET=

